#!/usr/bin/env bash
# rt-tree <dir>  -> git tree id of the CURRENT content of the worktree (tracked + untracked, honouring .gitignore,
# excluding .roundtable/). A review recorded for this id also covers the commit whose tree is the same id
# (so "reviewed before commit" == "reviewed head" when the Chief commits exactly what was reviewed).
set -uo pipefail
d="${1:-.}"
idx=$(mktemp -u "${TMPDIR:-/tmp}/rt-tree.XXXXXX")
trap 'rm -f "$idx"' EXIT
export GIT_INDEX_FILE="$idx"
git -C "$d" read-tree HEAD 2>/dev/null || exit 1
git -C "$d" add -A >/dev/null 2>&1 || exit 1
git -C "$d" rm -r -q --cached --ignore-unmatch .roundtable >/dev/null 2>&1
git -C "$d" write-tree
