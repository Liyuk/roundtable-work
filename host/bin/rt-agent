#!/usr/bin/env bash
# rt-agent <role> <workdir> <outfile> [--session-dir DIR] [--system FILE]...    (prompt on stdin)
# The ONLY place that starts a model process for the loop. The harness is chosen by RT_HARNESS in config.env
# (codex | pi; default pi) and the model per role is resolved here, so callers never name a harness or model.
#   roles  chief                          : orchestrates, commits, pushes, opens PRs (multi-wake session, no sandbox)
#          developer|fixer|researcher     : edits the worktree (no sandbox, like pi)
#          reviewer                       : Gate 1 independent review (own session; codex: no sandbox so tests run, verdict void if the tree changes; pi: no edit/write tools)
#          decider|threat|exploit         : read-only judgments (codex: read-only sandbox; pi: no edit/write tools)
#          opus-fix                       : escalation fix round, may edit/commit/push (no sandbox)
# Models: pi    -> RT_MODEL (chief/developer/fixer/researcher/reviewer) or RT_DECIDER_MODEL (decider/threat/exploit/opus-fix)
#         codex -> RT_CODEX_MODEL_<ROLE> (e.g. RT_CODEX_MODEL_OPUS_FIX), else RT_CODEX_MODEL
# outfile: the agent's answer text (codex: last message; pi: stdout+stderr as before). codex stderr -> <outfile>.stderr
# Chief continuation (--session-dir): pi uses --continue on that dir; codex stores the thread id in DIR/codex-thread-id and
# runs `codex exec resume <id>`; if the resume cannot start a turn, a fresh session is started with the same (full) prompt.
# Info: rt-agent --harness | rt-agent --model <role> | rt-agent --routing-facts | rt-agent --check
# Routing facts (2026-11-13): config.env is the ONLY routing source. Every new role start gets a generated
# "Routing facts for this turn" block (harness + model per role, DeepSeek no-funds fallback) appended to its system prompt, so
# prompts/policy never name models. --check exits 2 if any role has no model (start-box.sh runs it).
set -uo pipefail
RT_HOME="${RT_HOME:-$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)}"
[ -f "$RT_HOME/config.env" ] && { set -a; . "$RT_HOME/config.env"; set +a; }
# RT_HARNESS=auto (default): pi during DeepSeek off-peak, otherwise codex. Resolved here at
# each role start so an in-flight call is never interrupted; the next role start re-evaluates.
# Explicit RT_HARNESS=pi or RT_HARNESS=codex still forces that harness.
H="${RT_HARNESS:-auto}"
case "$H" in
  auto) H=$("$RT_HOME/bin/rt-window" --harness) || H=codex;;
  pi|codex) ;;
  *) echo "rt-agent: unknown RT_HARNESS=$H" >&2; exit 2;;
esac
model_for(){ # role
  local r="$1" v
  case "$H" in
    pi) v="RT_PI_MODEL_$(printf '%s' "$r" | tr 'a-z-' 'A-Z_')"; if [ -n "${!v:-}" ]; then echo "${!v}"; else case "$r" in decider|threat|exploit|opus-fix) echo "${RT_DECIDER_MODEL:-}";; *) echo "${RT_MODEL:-}";; esac; fi;;
    codex) v="RT_CODEX_MODEL_$(printf '%s' "$r" | tr 'a-z-' 'A-Z_')"; echo "${!v:-${RT_CODEX_MODEL:-}}";;
  esac
}
ROLES="chief developer fixer researcher reviewer decider threat exploit opus-fix"
xcheck_model(){ "$RT_HOME/bin/rt-window" --model xcheck 2>/dev/null || echo "${RT_XCHECK_MODEL:-}"; }
nofunds_active(){ local nf="$RT_HOME/state/deepseek-nofunds"; [ -f "$nf" ] && [ $(( $(date +%s) - $(stat -c %Y "$nf") )) -lt "${RT_NOFUNDS_TTL:-21600}" ]; }
routing_facts(){ # current role (optional)
  local r m fb="${RT_NOFUNDS_MODEL:-tokenarmy/claude-haiku-5-5}"
  echo "## Routing facts for this turn (generated by bin/rt-agent from config.env at this role start, $(date '+%F %T %Z'))"
  echo "This is the only source of truth for model routing. Other model names that appear in prompts, policy, logs, or old labels (for example opus, sonnet, codex, or a DeepSeek model id) do not describe the current routing. Names such as opus-fix, rt:opus-merge, and opus_fix_n are legacy labels only."
  [ -n "${1:-}" ] && echo "- Your role: $1 (harness $H, model $(model_for "$1"))"
  echo "- harness: $H (all roles)"
  for r in $ROLES; do
    m=$(model_for "$r")
    case "$r" in opus-fix) echo "- $r (only for an explicit hard-problem fix escalation): $m";; *) echo "- $r: $m";; esac
  done
  echo "- xcheck (Gate 2 cross-check): $(xcheck_model)"
  echo "- When DeepSeek returns insufficient balance (402): roles whose model id starts with deepseek/ automatically switch to $fb, then retry DeepSeek after $(( ${RT_NOFUNDS_TTL:-21600} / 3600 )) hours."
  if nofunds_active; then echo "- Current state: the DeepSeek insufficient-balance flag is active, so deepseek/ roles actually use $fb."; fi
  echo "- Chief does not call decider/threat/exploit/opus-fix directly; only the worker does. Any model listed above appearing in an rt-delegate receipt is expected and allowed."
}
check_routes(){
  local r m bad=0
  for r in $ROLES; do m=$(model_for "$r"); [ -n "$m" ] || { echo "rt-agent --check: no model for role $r (harness $H)" >&2; bad=1; }; done
  [ -n "$(xcheck_model)" ] || { echo "rt-agent --check: no model for role xcheck (harness $H)" >&2; bad=1; }
  [ "$bad" = 0 ] && echo "rt-agent --check: ok (harness $H, every role has a model)"
  return $(( bad * 2 ))
}
case "${1:-}" in
  --harness) echo "$H"; exit 0;;
  --model) model_for "${2:?role}"; exit 0;;
  --routing-facts) routing_facts "${2:-}"; exit 0;;
  --check) check_routes; exit $?;;
esac
role="${1:?role}"; wd="${2:?workdir}"; out="${3:?outfile}"; shift 3
case "$role" in chief|developer|fixer|researcher|reviewer|decider|threat|exploit|opus-fix) ;; *) echo "rt-agent: bad role $role" >&2; exit 2;; esac
case "$H" in pi|codex) ;; *) echo "rt-agent: unknown RT_HARNESS=$H" >&2; : >"$out"; exit 2;; esac
sdir=""; sys=()
while [ $# -gt 0 ]; do
  case "$1" in
    --session-dir) sdir="$2"; shift 2;;
    --system) sys+=("$2"); shift 2;;
    *) echo "rt-agent: bad option $1" >&2; exit 2;;
  esac
done
model=$(model_for "$role")
[ -n "$model" ] || { echo "rt-agent: no model configured for role $role (harness $H)" >&2; : >"$out"; exit 2; }
prompt=$(cat)
if [ "${RT_ROLE_MEMORY:-0}" = 1 ]; then   # #605: same memory section rtd appends; a failure keeps the prompt (launch proceeds)
  prompt2=$(printf '%s' "$prompt" | "$RT_HOME/bin/rt-role-memory.mjs" "$role") && prompt=$prompt2 || echo "[rt-agent] role memory preload failed; launching without it" >&2
fi
cd "$wd" || { : >"$out"; exit 2; }
# Inject the routing facts for this start (new starts only; a call already running keeps its prompt).
rf="$out.routing.md"; routing_facts "$role" >"$rf" 2>/dev/null && [ -s "$rf" ] && sys+=("$rf")

if [ "$H" = pi ]; then
  a=(-p --model "$model")
  for f in "${sys[@]}"; do a+=(--append-system-prompt "$f"); done
  case "$role" in
    chief) cont=(); ls "$sdir/"*.jsonl >/dev/null 2>&1 && cont=(--continue); a+=(--session-dir "$sdir" "${cont[@]}");;
    reviewer|decider|threat|exploit) a+=(--no-session --exclude-tools edit,write);;
    *) a+=(--no-session);;
  esac
  # DeepSeek out of balance -> fall back to RT_NOFUNDS_MODEL (owner 2026-11-13 01:13 PST). The flag lasts
  # RT_NOFUNDS_TTL seconds, then DeepSeek is tried again (a still-empty balance re-flags it).
  nf="$RT_HOME/state/deepseek-nofunds"; fb="${RT_NOFUNDS_MODEL:-tokenarmy/claude-haiku-5-5}"
  if [ "${model%%/*}" = deepseek ] && [ -f "$nf" ] && [ $(( $(date +%s) - $(stat -c %Y "$nf") )) -lt "${RT_NOFUNDS_TTL:-21600}" ]; then
    a=("${a[@]/#$model/$fb}"); model="$fb"
  fi
  pi "${a[@]}" "$prompt" </dev/null >"$out" 2>&1
  rc=$?
  if [ "$rc" -ne 0 ] && [ "${model%%/*}" = deepseek ] && tail -n 40 "$out" | grep -qiE 'insufficient[ _]balance|\b402\b|payment required|余额不足'; then
    date '+%F %T %Z' >"$nf"; echo "[rt-agent] deepseek out of balance -> $fb" >&2
    a=("${a[@]/#$model/$fb}"); model="$fb"
    pi "${a[@]}" "$prompt" </dev/null >"$out" 2>&1
    rc=$?
  fi
  if [ "$rc" -ne 0 ]; then   # a usage limit / 429 is a wait, never a verdict: flag it and exit 75 (EX_TEMPFAIL)
    tail -n 40 "$out" >"$out.tail" 2>/dev/null
    "$RT_HOME/bin/rt-limit" record pi "$role" "$out.tail" >/dev/null 2>&1 && { echo "[rt-agent] model usage limit (pi)" >&2; exit 75; }
  fi
  exit $rc
fi

# ---- codex ----------------------------------------------------------------------------------
CODEX="${RT_CODEX:-codex}"
case "$role" in
  decider|threat|exploit) sb=read-only;;
  # Same reach as the unsandboxed pi agent. The workspace-write sandbox broke real work on this host: child processes
  # (spawnSync EPERM), loopback listeners and namespaces are denied and gh has no network, so npm test fails and
  # reviewers answer block. The reviewer stays independent (own session) and rt-delegate discards its verdict if it
  # changes the worktree.
  chief|opus-fix|developer|fixer|researcher|reviewer) sb=danger-full-access;;
esac
if [ "${#sys[@]}" -gt 0 ]; then   # codex has no --append-system-prompt: put the role prompts in front of the task
  pre=""; for f in "${sys[@]}"; do [ -f "$f" ] && pre="$pre$(cat "$f")"$'\n\n'; done
  prompt="=== ROLE INSTRUCTIONS (system) ===
$pre=== TASK ===
$prompt"
fi
raw="$out.raw"; err="$out.stderr"; rm -f "$raw"
common=(-m "$model" --skip-git-repo-check -c approval_policy="never" -c sandbox_mode="$sb" -o "$raw")
export RT_AGENT_ROLE="$role"
if [ "$role" = chief ] && [ -n "$sdir" ]; then
  mkdir -p "$sdir"; tidf="$sdir/codex-thread-id"; j="$out.jsonl"; rc=1; started=0
  tid=$(cat "$tidf" 2>/dev/null | tr -dc '0-9a-zA-Z-')
  if [ -n "$tid" ]; then
    printf '%s' "$prompt" | "$CODEX" exec resume "$tid" "${common[@]}" --json - >"$j" 2>"$err"; rc=$?
    grep -q '"type":"turn.started"' "$j" 2>/dev/null && started=1
    [ "$started" = 1 ] || echo "[rt-agent] resume of $tid did not start a turn (rc=$rc); starting a fresh session" >>"$err"
  fi
  if [ "$started" = 0 ]; then
    printf '%s' "$prompt" | "$CODEX" exec "${common[@]}" -C "$wd" --color never --json - >"$j" 2>>"$err"; rc=$?
    nt=$(jq -r 'select(.type=="thread.started")|.thread_id' "$j" 2>/dev/null | head -1 | tr -dc '0-9a-zA-Z-')
    [ -n "$nt" ] && printf '%s\n' "$nt" >"$tidf"
  fi
else
  printf '%s' "$prompt" | "$CODEX" exec "${common[@]}" -C "$wd" --color never --ephemeral - >/dev/null 2>"$err"; rc=$?
fi
# Answer text = last message. Strip pure markdown fence lines and bold/backtick wrapping around a whole
# machine line (e.g. **DECIDE: resolve**) so the strict line parsers see the same text pi produced. Nothing else is rewritten.
if [ -s "$raw" ]; then
  sed -E -e '/^[[:space:]]*```[A-Za-z0-9_-]*[[:space:]]*$/d' \
         -e 's/^[[:space:]]*(\*\*|`)((DECIDE|EXPLOIT|JUDGE|THREAT MODEL|[Vv][Ee][Rr][Dd][Ii][Cc][Tt]|APPROVE-MERGE|REJECT-MERGE|OPUS_FIX|审查结论)[^*`]*)(\*\*|`)[[:space:]]*$/\2/' "$raw" >"$out"
else
  : >"$out"
fi
if [ "$rc" -ne 0 ] || [ ! -s "$out" ]; then   # a usage limit / 429 is a wait, never a verdict: flag it and exit 75
  if "$RT_HOME/bin/rt-limit" record codex "$role" "$err" "${j:-/dev/null}" >/dev/null 2>&1; then
    echo "[rt-agent] model usage limit (codex)" >>"$err"; : >"$out"; exit 75
  fi
fi
exit $rc
