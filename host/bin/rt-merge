#!/usr/bin/env python3
"""rt-merge <pr>      (needs RT_MERGE_STEP=1; RT_DRY_RUN=1 prints what it would do and writes nothing)

The ONLY place in rt-loop that runs `gh pr merge` (squash; never --admin, never --auto). It re-verifies everything
right before merging:
  PR open (else skip), head branch rt/<n>-* (or rt/revert-<sha7>), not in RT_HANDS_OFF_PRS, base main,
  gates file wt/<n>/.roundtable/state/gates.json all pass for the PR's CURRENT head, a `<!-- rt:gates -->` comment saying `Result: pass` for that head,
  safety-file diffs only with a recorded Opus APPROVE-MERGE (`<!-- rt:opus-merge -->` comment + gates.json),
  main not red (reverts excepted), not draft (runs `gh pr ready` first), mergeable, required checks green,
  `Closes #<n>` in the body (added with `gh pr edit` if missing).
Exit: 0 merged (or would merge), 1 error, 2 refused, 3 skipped (not open / hands-off), 5 needs sync with main,
      6 CI not green, 7 main red.   First failure line: `REFUSE[tag]: reason`.   Success: `MERGED: pr=<n> sha=<sha>`.
"""
import json
import os
import re
import subprocess
import sys
import time

HERE = os.path.dirname(os.path.abspath(__file__))
RT_HOME = os.environ.get("RT_HOME") or os.path.dirname(HERE)
GH = os.environ.get("RT_GH_REAL", "/usr/bin/gh")
DRY = bool(os.environ.get("RT_DRY_RUN"))


def load_cfg():
    cfg = {}
    try:
        for line in open(os.path.join(RT_HOME, "config.env"), encoding="utf-8"):
            line = line.strip()
            if line and not line.startswith("#") and "=" in line:
                k, v = line.split("=", 1)
                cfg[k.strip()] = re.split(r"\s+#", v, maxsplit=1)[0].strip().strip("'\"")
    except OSError:
        pass
    return cfg


CFG = load_cfg()
REPO = os.environ.get("RT_REPO") or CFG.get("RT_REPO", "Liyuk/roundtable-work")
HANDS_OFF = {int(x) for x in re.split(r"[\s,]+", os.environ.get("RT_HANDS_OFF_PRS", CFG.get("RT_HANDS_OFF_PRS", ""))) if x.isdigit()}


def gh(args, check=True, inp=None):
    r = subprocess.run([GH] + args, capture_output=True, text=True, input=inp, timeout=180)
    if check and r.returncode != 0:
        raise RuntimeError("gh %s failed: %s" % (" ".join(args[:2]), r.stderr.strip()[:200]))
    return r


def out(code, msg):
    print(msg)
    sys.exit(code)


def refuse(tag, msg, code=2):
    out(code, "REFUSE[%s]: %s" % (tag, msg))


def main(argv):
    if os.environ.get("RT_MERGE_STEP") != "1":
        refuse("step", "RT_MERGE_STEP=1 is required (rt-merge is only called by the worker's merge step)")
    if len(argv) != 2 or not argv[1].isdigit():
        out(1, "usage: rt-merge <pr>")
    num = int(argv[1])
    if num in HANDS_OFF:
        out(3, "SKIP[hands-off]: PR #%d is in RT_HANDS_OFF_PRS" % num)
    fields = "number,state,isDraft,mergeable,mergeStateStatus,headRefName,headRefOid,baseRefName,body,title,comments,files"
    try:
        pr = json.loads(gh(["pr", "view", str(num), "-R", REPO, "--json", fields]).stdout)
    except Exception as e:
        out(1, "ERROR: cannot read PR: %s" % e)
    if pr["state"] != "OPEN":
        out(3, "SKIP[not-open]: PR #%d is %s" % (num, pr["state"]))
    head = pr["headRefName"]
    m = re.match(r"^rt/(\d+)-", head)
    rv = re.match(r"^rt/revert-([0-9a-f]{7})$", head)
    if not (m or rv):
        refuse("branch", "head branch '%s' is not rt/<n>-*; the loop never touches other PRs" % head)
    if pr["baseRefName"] != "main":
        refuse("base", "PR base is '%s', not main (stacked PR whose base is still open)" % pr["baseRefName"], 5)
    n = int(m.group(1)) if m else None
    wtdir = "revert-" + rv.group(1) if rv else str(n)
    sha = pr["headRefOid"]
    # ---- main health (reverts are exempt: they are the cure)
    if not rv and os.path.exists(os.path.join(RT_HOME, "state", "main_red")):
        refuse("main-red", "main CI is red; merges are paused until it is green", 7)
    # ---- stacked: the base PR must already be merged
    if n:
        try:
            base_branch = open(os.path.join(RT_HOME, "state", "base", str(n))).read().strip()
        except OSError:
            base_branch = "main"
        if base_branch not in ("main", ""):
            r = gh(["pr", "list", "-R", REPO, "--head", base_branch, "--state", "open", "--json", "number"], check=False)
            if r.returncode == 0 and json.loads(r.stdout or "[]"):
                refuse("base-open", "stacked on %s whose PR is still open; merging would merge that branch too" % base_branch, 5)
    # ---- gates file
    gpath = os.path.join(RT_HOME, "wt", wtdir, ".roundtable", "state", "gates.json")
    try:
        g = json.load(open(gpath))
    except Exception:
        refuse("gates", "no readable gates.json for this worktree")
    if g.get("head") != sha:
        refuse("gates", "gates.json is for head %s, PR head is %s (changed after gating)" % (str(g.get("head"))[:7], sha[:7]))
    if g.get("pr") not in (None, num):
        refuse("gates", "gates.json belongs to PR #%s" % g.get("pr"))
    revert = g.get("kind") == "revert"
    if revert != bool(rv):
        refuse("gates", "gates.json kind does not match the branch")
    ok1 = g.get("gate1") == ("skipped-revert" if revert else "pass")
    if not (g.get("gate0") in ("pass", "overridden") and ok1 and g.get("gate2") in ("pass", "skipped", "unavailable")):
        refuse("gates", "gates.json is not all-pass (gate0=%s gate1=%s gate2=%s)" % (g.get("gate0"), g.get("gate1"), g.get("gate2")))
    comments = pr.get("comments") or []
    if not any("<!-- rt:gates -->" in (c.get("body") or "") and "Result: pass" in (c.get("body") or "")
               and ("Head: %s" % sha[:7]) in (c.get("body") or "") for c in comments):
        refuse("gates", "PR has no <!-- rt:gates --> comment with 'Result: pass' for head %s" % sha[:7])
    # ---- safety files need a recorded Opus approval
    names = [f.get("path", "") for f in (pr.get("files") or [])]
    sf = subprocess.run([os.path.join(RT_HOME, "bin", "rt-safety")] + names, capture_output=True, text=True)
    if sf.returncode == 1 and not revert:
        if not (g.get("safety_approved") is True and g.get("safety_head") == sha
                and any("<!-- rt:opus-merge -->" in (c.get("body") or "") for c in comments)):
            refuse("safety", "diff touches safety files (%s) without a recorded Opus APPROVE-MERGE" % ", ".join(sf.stdout.split()[:5]))
    # ---- Closes #n
    body = pr.get("body") or ""
    needs_close = bool(n) and not re.search(r"\b(?:close[sd]?|fix(?:e[sd])?|resolve[sd]?)\s+#%d\b" % n, body, re.I)
    # ---- draft / mergeable / CI
    if DRY:
        print("DRY would: %s%s" % ("gh pr ready; " if pr["isDraft"] else "", "gh pr edit (append 'Closes #%d'); " % n if needs_close else ""))
    mg = pr.get("mergeable")
    for _ in range(4):
        if mg != "UNKNOWN":
            break
        time.sleep(3)
        mg = json.loads(gh(["pr", "view", str(num), "-R", REPO, "--json", "mergeable"]).stdout)["mergeable"]
    if mg == "CONFLICTING" or pr.get("mergeStateStatus") in ("DIRTY", "BEHIND"):
        refuse("sync", "PR is %s / %s with main; sync origin/main first" % (mg, pr.get("mergeStateStatus")), 5)
    if mg != "MERGEABLE":
        refuse("mergeable", "mergeable=%s" % mg)
    r = gh(["pr", "checks", str(num), "-R", REPO, "--required"], check=False)
    lines = [l for l in r.stdout.splitlines() if l.strip()]
    states = [l.split("\t")[1].strip() for l in lines if "\t" in l]
    if r.returncode != 0 or not states or any(s not in ("pass", "skipping") for s in states):
        tag = "ci-none" if (not states and "no required checks" in (r.stdout + r.stderr).lower()) else "ci"
        refuse(tag, "required checks are not green: %s" % ("; ".join(l.replace("\t", " ")[:100] for l in lines[:6]) or (r.stderr.strip()[:150] or "none reported")), 6)
    # ---- act
    if DRY:
        out(0, "DRY would merge PR #%d: gh pr merge %d --squash --match-head-commit %s (all re-verifications passed)" % (num, num, sha[:7]))
    if pr["isDraft"]:
        gh(["pr", "ready", str(num), "-R", REPO])
    if needs_close:
        gh(["pr", "edit", str(num), "-R", REPO, "--body-file", "-"], inp=(body.rstrip() + "\n\nCloses #%d\n" % n))
    r = gh(["pr", "merge", str(num), "-R", REPO, "--squash", "--match-head-commit", sha, "--body", ("Closes #%d" % n) if n else ""], check=False)  # explicit body: no Co-authored-by trailers
    if r.returncode != 0:
        out(1, "ERROR: gh pr merge failed: %s" % r.stderr.strip()[:200])
    v = json.loads(gh(["pr", "view", str(num), "-R", REPO, "--json", "state,mergeCommit"]).stdout)
    msha = ((v.get("mergeCommit") or {}).get("oid")) or ""
    os.makedirs(os.path.join(RT_HOME, "state"), exist_ok=True)
    with open(os.path.join(RT_HOME, "state", "merges.log"), "a") as f:
        f.write("%s\t%d\t%s\t%s\t%s\n" % (time.strftime("%F %T %Z"), num, n if n else "revert", msha, sha))
    out(0, "MERGED: pr=%d sha=%s" % (num, msha))


if __name__ == "__main__":
    main(sys.argv)
