#!/usr/bin/env python3
"""rt-state <n> get <key> [default] | set <key> <value> | inc <key> | reset | dump

Per-issue persistent state in $RT_HOME/state/issues/<n>.json (decide_n, fix_n, review_n, merge_hold, ...).
Atomic (flock + rename). Values given to `set` are parsed as JSON when possible, else stored as strings.
`reset` zeroes the counters (decide_n, fix_n, review_n, safety_n, opus_fix_n, opus_exploit_n) and clears merge_hold.
"""
import fcntl
import json
import os
import sys

HERE = os.path.dirname(os.path.abspath(__file__))
RT_HOME = os.environ.get("RT_HOME") or os.path.dirname(HERE)
COUNTERS = ("decide_n", "fix_n", "review_n", "safety_n", "opus_fix_n", "opus_exploit_n")


def path(n):
    d = os.path.join(RT_HOME, "state", "issues")
    os.makedirs(d, exist_ok=True)
    return os.path.join(d, "%s.json" % n)


def main(a):
    if len(a) < 3 or not a[1].isdigit():
        print(__doc__, file=sys.stderr)
        return 2
    n, op = a[1], a[2]
    p = path(n)
    with open(p + ".lock", "w") as lk:
        fcntl.flock(lk, fcntl.LOCK_EX)
        try:
            d = json.load(open(p))
        except (OSError, ValueError):
            d = {}
        out = None
        if op == "get":
            v = d.get(a[3], a[4] if len(a) > 4 else "")
            out = v if isinstance(v, str) else json.dumps(v)
        elif op == "dump":
            out = json.dumps(d, sort_keys=True)
        else:
            if op == "set":
                try:
                    d[a[3]] = json.loads(a[4])
                except ValueError:
                    d[a[3]] = a[4]
            elif op == "inc":
                d[a[3]] = int(d.get(a[3], 0)) + 1
                out = str(d[a[3]])
            elif op == "reset":
                for k in COUNTERS:
                    d[k] = 0
                d["merge_hold"] = ""
            else:
                print(__doc__, file=sys.stderr)
                return 2
            tmp = p + ".tmp"
            json.dump(d, open(tmp, "w"), sort_keys=True)
            os.replace(tmp, p)
    if out is not None:
        print(out)
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv))
