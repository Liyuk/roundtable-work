# rt-loop single config (sourced by bash, parsed by rt-sched.py). Values win over the environment.
# Harness: every model process (Chief, developer/fixer/researcher, Gate 1 reviewer, decider, threat model,
# hard-problem fix (opus-fix), exploitability judgment) is started by bin/rt-agent. Gate 2 (bin/rt-xcheck) uses the same
# windowed selection. RT_HARNESS=auto (this host): at each *new* role start, use pi during DeepSeek
# off-peak and codex otherwise. A call already in progress is never interrupted. Explicit pi|codex
# remains a manual override. Official peak windows:
#   https://api-docs.deepseek.com/quick_start/pricing/
#   UTC Mon-Fri 01:00-04:00 and 06:00-10:00, excluding Chinese public holidays.
#   Equivalent Beijing/CST: Mon-Fri 09:00-12:00 and 14:00-18:00.
#   Pacific Time (PST, UTC-8): Sun-Thu 17:00-20:00 and 22:00-02:00 next day (Fri ends 02:00);
#   during PDT (UTC-7) those local times are one hour later. Weekends and holidays are off-peak.
RT_HARNESS=auto                            # auto | pi | codex
# Temporary pin. pi = every role starts on pi (models below), including during peak, until this is cleared.
# To resume official off-peak/peak switching: set RT_FORCE_HARNESS=  (empty) or comment the line out.
# A new role start picks the change up immediately; an in-flight call is not interrupted.
# Codex is not used as a fallback while this is set; a DeepSeek/pi rate limit pauses the loop.
RT_FORCE_HARNESS=pi                        # owner 2026-11-12 23:47 PST: all roles on pi, no codex (models: see RT_MODEL etc. below)
RT_PEAK_TZ=UTC
RT_PEAK_WEEKDAYS=Mon-Fri
RT_PEAK_WINDOWS=01:00-04:00,06:00-10:00    # half-open [start, end)
# Holidays are off-peak all day in Beijing time. 2026 dates follow the State Council notice
# (国办发明电〔2025〕7号): https://www.gov.cn/zhengce/zhengceku/202511/content_7047091.htm
# (official 放假 days, including weekday 调休 rest days). 2027-01-01 is the statutory New Year day.
RT_OFFPEAK_HOLIDAY_TZ=Asia/Shanghai
RT_OFFPEAK_HOLIDAYS=2026-01-01,2026-01-02,2026-01-03,2026-02-15,2026-02-16,2026-02-17,2026-02-18,2026-02-19,2026-02-20,2026-02-21,2026-02-22,2026-02-23,2026-04-04,2026-04-05,2026-04-06,2026-05-01,2026-05-02,2026-05-03,2026-05-04,2026-05-05,2026-06-19,2026-06-20,2026-06-21,2026-09-25,2026-09-26,2026-09-27,2026-10-01,2026-10-02,2026-10-03,2026-10-04,2026-10-05,2026-10-06,2026-10-07,2027-01-01
# Off-peak (pi) models. List models: pi --list-models deepseek
# owner 2026-11-13 11:14 PST: DeepSeek balance nearly exhausted -> ALL roles default to pi + haiku. Review/acceptance/decider are NOT
# escalated to a stronger tier. Only the explicit hard-problem fixer escalation (role opus-fix, legacy name) uses sonnet; no opus anywhere.
# This file is the single routing source: bin/rt-agent injects the resolved map ("本轮路由事实") into every new role; see bin/rt-agent --routing-facts.
# Previous values (to restore when DeepSeek is topped up): RT_MODEL=deepseek/deepseek-flash, RT_DECIDER_MODEL / RT_PI_MODEL_REVIEWER / RT_PI_MODEL_XCHECK=deepseek/deepseek-v4-pro
RT_MODEL=tokenarmy/claude-haiku-5-5          # chief, developer, fixer, researcher
RT_DECIDER_MODEL=tokenarmy/claude-haiku-5-5  # decider, threat, exploit (acceptance/judgment roles)
# Peak (codex) models per role (RT_CODEX_MODEL_<ROLE> wins over RT_CODEX_MODEL).
# NOT USED at present: RT_FORCE_HARNESS=pi (owner 2026-11-12 23:47 PST), so no role starts on codex. Kept only for a future manual switch.
RT_CODEX_MODEL=gpt-6-luna
RT_CODEX_MODEL_CHIEF=gpt-6-luna
RT_CODEX_MODEL_DEVELOPER=gpt-6-luna
RT_CODEX_MODEL_FIXER=gpt-6.1-terra
RT_CODEX_MODEL_RESEARCHER=gpt-6-luna
RT_CODEX_MODEL_REVIEWER=gpt-6.1-terra      # Gate 1 (owner 2026-11-12: reviewer stronger than developer)
RT_CODEX_MODEL_DECIDER=gpt-6.1-terra
RT_CODEX_MODEL_THREAT=gpt-6.1-terra
RT_CODEX_MODEL_OPUS_FIX=gpt-6.1-terra
RT_CODEX_MODEL_EXPLOIT=gpt-6.1-terra
RT_XCHECK_MODEL=gpt-6.1-terra              # Gate 2 when the resolved harness is codex (stronger than developer)
RT_WORKERS=6
# Resource-aware admission (hot-reloaded each cycle). New claims pause when any threshold is
# exceeded; already-running workers are left alone. After a long scheduler cycle gap (box freeze),
# new claims also wait 5 minutes so a recovery spike does not stack on a fresh intake.
RT_MAX_LOAD=8          # 1-minute load average ceiling (os.getloadavg); default nproc*1.0
RT_MIN_MEM_MB=2500     # pause new claims when /proc/meminfo MemAvailable is below this (MiB)
RT_MAX_MEM_PSI=10      # pause new claims when /proc/pressure/memory some avg60 exceeds this
RT_LENIENT=1           # owner 2026-11-12 lenient merge mode: Gate 1 reject after the review/fix budget is non-blocking (findings go to the PR body);
                       # Gate 2 blocks only in-scope CRITICAL findings with a concrete trigger. Gate 0, CI, privacy, no-force-push, safety-file rules unchanged.
RT_POLL=300            # seconds between scheduler cycles
RT_OWNER=Liyuk
RT_REPO=Liyuk/roundtable-work
RT_MAXWAKE=4
RT_DECIDE_MAX=2        # max Opus decider calls per issue (per worker run)
RT_HANDS_OFF_PRS=      # PR numbers the loop must never touch (comma/space separated); default empty
RT_AUTOMERGE=1         # 1: after all gates + CI are green the worker squash-merges via bin/rt-merge; 0: stop at rt:ready-to-merge
RT_CI_TIMEOUT=1200     # seconds to wait for required checks (gh pr checks --watch --required)
RT_REVIEW_MAX=8        # max worker-run Gate 1 reviewer runs per issue (persisted in state/issues/<n>.json)
# commit identity: always the owner noreply address (no third-party accounts, no host names)
GIT_AUTHOR_NAME=Liyuk
GIT_AUTHOR_EMAIL=
GIT_COMMITTER_NAME=Liyuk
GIT_COMMITTER_EMAIL=

# Off-peak (pi) per-role overrides: RT_PI_MODEL_<ROLE> wins over RT_MODEL / RT_DECIDER_MODEL. (owner 2026-11-12)
RT_PI_MODEL_REVIEWER=tokenarmy/claude-haiku-5-5   # Gate 1 (owner 2026-11-13 11:14 PST: no escalation to sonnet/opus)
RT_PI_MODEL_XCHECK=tokenarmy/claude-haiku-5-5     # Gate 2
RT_PI_MODEL_OPUS_FIX=tokenarmy/claude-sonnet-5-5  # only the explicit hard-problem fixer escalation (role opus-fix is a legacy name)
RT_AUTO_FOLLOWUPS=0    # owner 2026-11-12 acceptance-criteria-first: 0 = never auto-open follow-up issues (Gate 2 / exploit downgrade);
                       # non-blocking findings go to a PR comment only. 1 = old behavior. Scheduler claims rt:followup / rt:self issues only with rt:go.
# owner 2026-11-13 01:13 PST: when DeepSeek is out of balance, every role falls back to this model; retry DeepSeek after TTL seconds
RT_NOFUNDS_MODEL=tokenarmy/claude-haiku-5-5
RT_NOFUNDS_TTL=21600
