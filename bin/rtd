#!/usr/bin/env node
import { access, mkdir, readFile, rm, statfs, writeFile } from 'node:fs/promises';
import { constants, readFileSync, realpathSync } from 'node:fs';
import { spawnSync } from 'node:child_process';
import { join } from 'node:path';
import { parseArgs } from 'node:util';
import { pathToFileURL } from 'node:url';

const TEMPLATE_DIR = new URL('../deploy/systemd/user/', import.meta.url);
const UNITS = ['rtd.service', 'rtd-watchdog.service', 'rtd-watchdog.timer'];
const MANIFEST = 'rtd-install.manifest.json';
const HEADER = '# Generated by rtd install. Do not edit by hand; run rtd uninstall to remove.';
const LABEL = 'io.roundtable.rtd';
const PLIST = `${LABEL}.plist`;
const ENABLE_COMMANDS = [
  'systemctl --user daemon-reload',
  'systemctl --user enable --now rtd.service',
  'systemctl --user enable --now rtd-watchdog.timer',
];
const LAUNCHD_NOTES = [
  'Note: launchd does not load EnvironmentFile; add non-secret variables under EnvironmentVariables yourself.',
  'Note: the machine must not sleep while rtd runs (e.g. run caffeinate -i or set Energy settings).',
];
const HARNESS_CONFIG = new URL('../runtime/harness.config.json', import.meta.url);
// bin/ is launch-only and may not import runtime modules, so these mirror runtime/lib/harness.mjs and supervisor/heartbeat.mjs.
const IN_PROCESS_HARNESSES = new Set(['host-agent']);
const HEARTBEAT_PATH = '.roundtable/state/heartbeat.json';
const USAGE = 'usage: rtd install|uninstall|doctor [options]\n';
const HINTS = {
  DOCTOR_GH_AUTH: 'Run `gh auth login` and grant the repo scope.',
  DOCTOR_HARNESS_MISSING: 'Install the harness CLI on PATH and log in to it.',
  DOCTOR_REPO_ACCESS: 'Sign in to gh with an account that can read the repo, or pass the right --repo.',
  DOCTOR_STATE_NOT_WRITABLE: 'Make the workspace .roundtable/state directory writable by the rtd user.',
  DOCTOR_DISK_LOW: 'Free disk space on the workspace filesystem, or lower --min-free-mb.',
  DOCTOR_SERVICE_DOWN: 'Start the service: systemctl --user enable --now rtd.service (macOS: bootstrap the io.roundtable.rtd LaunchAgent).',
  DOCTOR_HEARTBEAT_STALE: 'Check the rtd daemon is running and writing its heartbeat; restart it if it has stopped.',
};

export function renderUnits(o) {
  const subs = {
    '<workspace>': o.workspace,
    '<env-file>': o.envFile,
    '<handler-module>': o.handler,
    '<providers-module>': o.providers,
    '<routing-file>': o.routing,
    '<alert-issue>': o.alertIssue,
  };
  const out = {};
  for (const name of UNITS) {
    const template = readFileSync(new URL(name, TEMPLATE_DIR), 'utf8');
    let content = `${HEADER}\n${template.replace(/^(#.*\n)+/, '')}`;
    for (const [key, value] of Object.entries(subs)) content = content.replaceAll(key, value);
    if (/<[a-z-]+>/.test(content)) throw new Error(`unresolved placeholder in ${name}`);
    out[name] = content;
  }
  return out;
}

const xml = (s) => s.replace(/[&<>"']/g, (c) => `&#${c.charCodeAt(0)};`);

export function renderPlist(o) {
  const ws = o.workspace;
  const args = ['/usr/bin/env', 'node', `${ws}/runtime/rtd.mjs`, '--work-root', `${ws}/.roundtable`,
    '--github', '--handler', o.handler, '--providers', o.providers, '--routing', o.routing, '--loop'];
  const str = (s) => `<string>${xml(s)}</string>`;
  return [
    '<?xml version="1.0" encoding="UTF-8"?>',
    '<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">',
    '<!-- Generated by rtd install. Do not edit by hand; run rtd uninstall to remove. -->',
    '<plist version="1.0">',
    '<dict>',
    '\t<key>Label</key>',
    `\t${str(LABEL)}`,
    '\t<key>ProgramArguments</key>',
    '\t<array>',
    ...args.map((a) => `\t\t${str(a)}`),
    '\t</array>',
    '\t<key>WorkingDirectory</key>',
    `\t${str(ws)}`,
    '\t<key>RunAtLoad</key>',
    '\t<true/>',
    '\t<key>KeepAlive</key>',
    '\t<true/>',
    '\t<key>StandardOutPath</key>',
    `\t${str(`${ws}/.roundtable/logs/rtd.out.log`)}`,
    '\t<key>StandardErrorPath</key>',
    `\t${str(`${ws}/.roundtable/logs/rtd.err.log`)}`,
    '</dict>',
    '</plist>',
  ].join('\n') + '\n';
}

const launchdCommands = (plistPath) => [
  `launchctl bootstrap gui/$(id -u) ${plistPath}`,
  `launchctl bootout gui/$(id -u)/${LABEL}`,
];

const exists = (p) => access(p).then(() => true, () => false);

function defaultUnitDir(platform, env) {
  if (platform === 'darwin') return join(env.HOME, 'Library/LaunchAgents');
  return env.XDG_CONFIG_HOME
    ? join(env.XDG_CONFIG_HOME, 'systemd/user')
    : join(env.HOME, '.config/systemd/user');
}

async function install(v, platform, unitDir, { dryRun, stdout, stderr }) {
  const required = ['workspace', 'env-path', 'handler', 'providers', 'routing', 'alert-issue'];
  const missing = required.find((k) => !v[k]);
  if (missing) {
    stderr.write(`rtd install: missing required --${missing}\n${USAGE}`);
    return 2;
  }
  const darwin = platform === 'darwin';
  const o = {
    workspace: v.workspace,
    envFile: v['env-path'],
    handler: v.handler,
    providers: v.providers,
    routing: v.routing,
    alertIssue: v['alert-issue'],
  };
  const units = darwin ? { [PLIST]: renderPlist(o) } : renderUnits(o);
  const names = Object.keys(units);
  const [verb, Verb] = darwin ? ['load', 'Load'] : ['enable', 'Enable'];
  const commands = darwin ? launchdCommands(join(unitDir, PLIST)) : ENABLE_COMMANDS;
  const notes = darwin ? `${LAUNCHD_NOTES.join('\n')}\n` : '';
  if (dryRun) {
    for (const name of names) stdout.write(`# would write ${join(unitDir, name)}\n${units[name]}\n`);
    stdout.write(`Would ${verb} with (not run):\n${commands.join('\n')}\n${notes}`);
    return 0;
  }
  if ((await Promise.all(names.map((n) => exists(join(unitDir, n))))).some(Boolean)) {
    stderr.write(`rtd install: refusing to overwrite existing unit files in ${unitDir}\n`);
    return 1;
  }
  await mkdir(unitDir, { recursive: true });
  for (const name of names) await writeFile(join(unitDir, name), units[name]);
  await writeFile(join(unitDir, MANIFEST), `${JSON.stringify({ schemaVersion: 1, files: names }, null, 2)}\n`);
  stdout.write(`Wrote ${names.length} units and ${MANIFEST} to ${unitDir}\n`);
  stdout.write(`${Verb} with (not run):\n${commands.join('\n')}\n${notes}`);
  return 0;
}

async function uninstall(unitDir, { stdout, stderr }) {
  let manifest;
  try {
    manifest = JSON.parse(await readFile(join(unitDir, MANIFEST), 'utf8'));
  } catch (err) {
    if (err.code !== 'ENOENT') throw err;
    stderr.write(`rtd uninstall: no rtd install manifest in ${unitDir}\n`);
    return 1;
  }
  for (const name of manifest.files) {
    const path = join(unitDir, name);
    if (!(await exists(path))) continue;
    await rm(path);
    stdout.write(`Removed ${path}\n`);
  }
  await rm(join(unitDir, MANIFEST));
  stdout.write(`Removed ${join(unitDir, MANIFEST)}\n`);
  return 0;
}

function defaultProbes({ workspace }, platform) {
  return {
    ghAuth: () => {
      const r = spawnSync('gh', ['auth', 'status'], { encoding: 'utf8' });
      const out = `${r.stdout}${r.stderr}`;
      return r.status === 0 && (!/Token scopes:/.test(out) || /Token scopes:.*'repo'/.test(out));
    },
    harnesses: async () => {
      const config = JSON.parse(await readFile(HARNESS_CONFIG, 'utf8'));
      return [...new Set(Object.values(config.roles))].filter((n) => !IN_PROCESS_HARNESSES.has(n));
    },
    harness: (name) => spawnSync(name, ['--version'], { stdio: 'ignore' }).status === 0,
    repoAccess: (repo) => spawnSync('gh', ['repo', 'view', ...(repo ? [repo] : [])], { cwd: workspace, stdio: 'ignore' }).status === 0,
    stateWritable: (dir) => access(dir, constants.W_OK).then(() => true, () => false),
    freeBytes: async (dir) => {
      const s = await statfs(dir);
      return s.bavail * s.bsize;
    },
    service: () => {
      if (platform === 'linux') return spawnSync('systemctl', ['--user', 'is-active', '--quiet', 'rtd.service'], { stdio: 'ignore' }).status === 0;
      if (platform !== 'darwin') return false;
      const r = spawnSync('launchctl', ['print', `gui/${process.getuid()}/${LABEL}`], { encoding: 'utf8' });
      return r.status === 0 && r.stdout.includes('state = running');
    },
    heartbeat: (ws) => readFile(join(ws, HEARTBEAT_PATH), 'utf8').catch(() => undefined),
  };
}

const intArg = (value, fallback) => {
  if (value === undefined) return fallback;
  if (!/^\d+$/.test(value)) throw new Error(`invalid number: ${value}`);
  return Number(value);
};

const attempt = async (fn) => {
  try {
    return await fn();
  } catch {
    return undefined;
  }
};

async function doctor(args, { platform, probes, now, cwd, stdout, stderr }) {
  const options = {
    json: { type: 'boolean' },
    workspace: { type: 'string' },
    repo: { type: 'string' },
    'min-free-mb': { type: 'string' },
    'max-heartbeat-age-ms': { type: 'string' },
  };
  let o;
  try {
    const v = parseArgs({ args, options, strict: true }).values;
    o = {
      json: v.json,
      workspace: v.workspace ?? cwd,
      repo: v.repo,
      minFreeMb: intArg(v['min-free-mb'], 1024),
      maxHeartbeatAgeMs: intArg(v['max-heartbeat-age-ms'], 120000),
    };
  } catch (err) {
    stderr.write(`rtd doctor: ${err.message}\n${USAGE}`);
    return 2;
  }
  const p = { ...defaultProbes(o, platform), ...probes };
  const checks = [];
  const check = (name, ok, code) => checks.push({ name, ok: !!ok, code: ok ? null : code, hint: ok ? null : HINTS[code] });

  check('gh-auth', await attempt(() => p.ghAuth()), 'DOCTOR_GH_AUTH');
  const names = await attempt(() => p.harnesses());
  if (names === undefined) check('harnesses', false, 'DOCTOR_HARNESS_MISSING');
  for (const name of names ?? []) check(`harness:${name}`, await attempt(() => p.harness(name)), 'DOCTOR_HARNESS_MISSING');
  check('repo-access', await attempt(() => p.repoAccess(o.repo)), 'DOCTOR_REPO_ACCESS');
  check('state-dir', await attempt(() => p.stateWritable(join(o.workspace, '.roundtable/state'))), 'DOCTOR_STATE_NOT_WRITABLE');
  const free = await attempt(() => p.freeBytes(o.workspace));
  check('disk', free >= o.minFreeMb * 1024 * 1024, 'DOCTOR_DISK_LOW');
  check('service', await attempt(() => p.service()), 'DOCTOR_SERVICE_DOWN');
  const writtenAt = await attempt(async () => JSON.parse(await p.heartbeat(o.workspace)).writtenAt);
  check('heartbeat', typeof writtenAt === 'number' && now - writtenAt <= o.maxHeartbeatAgeMs, 'DOCTOR_HEARTBEAT_STALE');

  const ok = checks.every((c) => c.ok);
  if (o.json) {
    stdout.write(`${JSON.stringify({ ok, checks }, null, 2)}\n`);
  } else {
    for (const c of checks) stdout.write(c.ok ? `PASS ${c.name}\n` : `FAIL ${c.name} [${c.code}] fix: ${c.hint}\n`);
    const failed = checks.filter((c) => !c.ok).length;
    stdout.write(failed ? `doctor: ${failed} of ${checks.length} checks failed\n` : `doctor: all ${checks.length} checks passed\n`);
  }
  return ok ? 0 : 1;
}

export async function main(argv, { platform, env, stdout, stderr, probes = {}, now = Date.now(), cwd = process.cwd() }) {
  const [sub, ...rest] = argv;
  if (sub === 'doctor') return doctor(rest, { platform, probes, now, cwd, stdout, stderr });
  if (sub !== 'install' && sub !== 'uninstall') {
    stderr.write(USAGE);
    return 2;
  }
  if (platform !== 'linux' && platform !== 'darwin') {
    stderr.write(`rtd ${sub}: not supported on ${platform}; Linux and macOS only\n`);
    return 2;
  }
  const options = {
    workspace: { type: 'string' },
    'env-path': { type: 'string' },
    handler: { type: 'string' },
    providers: { type: 'string' },
    routing: { type: 'string' },
    'alert-issue': { type: 'string' },
    'unit-dir': { type: 'string' },
    'dry-run': { type: 'boolean' },
  };
  let parsed;
  try {
    parsed = parseArgs({ args: rest, options, strict: true }).values;
  } catch (err) {
    stderr.write(`rtd ${sub}: ${err.message}\n${USAGE}`);
    return 2;
  }
  const unitDir = parsed['unit-dir'] ?? defaultUnitDir(platform, env);
  if (sub === 'install') return install(parsed, platform, unitDir, { dryRun: parsed['dry-run'], stdout, stderr });
  return uninstall(unitDir, { stdout, stderr });
}

if (process.argv[1] && pathToFileURL(realpathSync(process.argv[1])).href === import.meta.url) {
  process.exitCode = await main(process.argv.slice(2), {
    platform: process.platform,
    env: process.env,
    stdout: process.stdout,
    stderr: process.stderr,
  });
}
