# TEMPLATE ONLY. Not enabled, not installed, and not referenced by any script.
# Before installing, replace every <placeholder> with a value for your host. Keep secrets
# (credentials) in the env file only, never in this unit. See docs/supervisor.md.
[Unit]
Description=Roundtable Work daemon (rtd)
After=network-online.target

[Service]
Type=simple
User=<daemon-user>
WorkingDirectory=<workspace>
EnvironmentFile=-<env-file>
ExecStart=/usr/bin/env node <workspace>/runtime/rtd.mjs --work-root <workspace>/.roundtable --github --handler <handler-module> --providers <providers-module> --routing <routing-file>
Restart=on-failure
